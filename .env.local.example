# Copy this file to .env.local and fill in what you have. Any platform left
# blank simply shows as "not configured" in the agent — the rest still work.
# Full walkthrough for getting each value: see SETUP.md.

# --- Claude (required for the agent chat itself) ---
ANTHROPIC_API_KEY=
# Optional: override the model the agent runs on. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Google (shared by Search Console, YouTube, Gmail, Calendar,
#     Drive, Sheets CRM and Analytics — one OAuth app covers all of it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Search Console: the exact property as it appears in GSC.
# e.g. https://example.com/  or  sc-domain:example.com
GSC_SITE_URL=

# YouTube: the channel ID (starts with UC...)
YOUTUBE_CHANNEL_ID=

# Google Analytics 4: the numeric property ID (Admin → Property Settings)
GA4_PROPERTY_ID=

# CRM: the ID from your Google Sheet's URL
# (docs.google.com/spreadsheets/d/THIS_PART/edit). Row 1 must be headers,
# and should include at least "Name" and "Stage" columns.
CRM_SHEET_ID=
CRM_SHEET_NAME=Sheet1

# --- Stripe (finance) ---
# Use a restricted key with read-only permissions — the agent never writes here.
STRIPE_SECRET_KEY=

# --- Meta (Facebook Page + Instagram Business account) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- X (Twitter) ---
# Read-only stats work with just these two:
X_BEARER_TOKEN=
X_USERNAME=
# Posting also needs a user-context OAuth2 token with the tweet.write scope
# (the bearer token above is app-only and can't post on your behalf):
X_ACCESS_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# One-time seed value — the app persists rotated refresh tokens to
# data/agent-state.json after the first call, so you only set this once.
TIKTOK_REFRESH_TOKEN=
