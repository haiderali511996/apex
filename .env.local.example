# Copy this file to .env.local and fill in what you have. Any platform left
# blank simply shows as "not configured" in the agent — the rest still work.
# Full walkthrough for getting each value: see SETUP.md.

# --- Claude (required for the agent chat itself) ---
# Which backend runs a turn. Leave unset (or "api") to call the Claude API
# with the key below. Set to "claude-code" to hand the turn to your local
# Claude Code instead, which bills against whatever that is signed in as —
# your subscription rather than API credits. See SETUP.md section 1.
IMEX_BACKEND=
# Only used by the claude-code backend; defaults to whatever Claude Code is
# set to. e.g. claude-opus-5-5
IMEX_CLAUDE_CODE_MODEL=

ANTHROPIC_API_KEY=
# Only needed if your key is identity-linked (issued to you rather than to a
# workspace). Without it those keys fail with "anthropic-workspace-id is
# required". Console → Settings → Workspaces; the id starts with wrkspc_.
ANTHROPIC_WORKSPACE_ID=
# Optional: override the model the agent runs on. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Voice (optional, but this is what stops Imex sounding like a robot) ---
# Without these, speech falls back to the operating system's built-in voice.
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Required once the key is set. With the key in place, GET /api/tts lists
# every voice on your account with its id, so you can pick one by name.
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2. GET /api/tts also lists the
# models your account can use — a turbo/flash model trades a little quality
# for noticeably lower latency, which suits a back-and-forth conversation.
ELEVENLABS_MODEL_ID=

# --- Google (shared by Search Console, YouTube, Gmail, Calendar,
#     Drive, Sheets CRM and Analytics — one OAuth app covers all of it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Search Console: the exact property as it appears in GSC.
# e.g. https://example.com/  or  sc-domain:example.com
GSC_SITE_URL=

# YouTube: the channel ID (starts with UC...)
YOUTUBE_CHANNEL_ID=

# Google Analytics 4: the numeric property ID (Admin → Property Settings)
GA4_PROPERTY_ID=

# CRM: the ID from your Google Sheet's URL
# (docs.google.com/spreadsheets/d/THIS_PART/edit). Row 1 must be headers,
# and should include at least "Name" and "Stage" columns.
CRM_SHEET_ID=
CRM_SHEET_NAME=Sheet1

# --- Stripe (finance) ---
# Use a restricted key with read-only permissions — the agent never writes here.
STRIPE_SECRET_KEY=

# --- Meta (Facebook Page + Instagram Business account) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- X (Twitter) ---
# Read-only stats work with just these two:
X_BEARER_TOKEN=
X_USERNAME=
# Posting also needs a user-context OAuth2 token with the tweet.write scope
# (the bearer token above is app-only and can't post on your behalf):
X_ACCESS_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# One-time seed value — the app persists rotated refresh tokens to
# data/agent-state.json after the first call, so you only set this once.
TIKTOK_REFRESH_TOKEN=
